# Copy to .env and replace every CHANGE_ME. Never commit .env.
# Avoid '$' in values (Compose treats it as expansion).

# ---- Domains ----
ZITADEL_DOMAIN=auth.bdren.localhost     # prod: auth.bdren.ai
ZITADEL_EXTERNALPORT=8080               # prod: 443
ZITADEL_EXTERNALSECURE=false            # prod: true
ZITADEL_PUBLIC_SCHEME=http              # prod: https
PROXY_HTTP_PUBLISHED_PORT=8080          # prod: 80 (443 via docker-compose.prod.yml)

# ---- Pinned images ----
ZITADEL_VERSION=v4.20.3
POSTGRES_IMAGE=postgres:17.10-alpine
REDIS_IMAGE=redis:7.4.9-alpine
NGINX_IMAGE=nginx:1.27.5-alpine

# ---- Secrets (generate: openssl rand -hex 16 / openssl rand -base64 24) ----
ZITADEL_MASTERKEY=CHANGE_ME_exactly_32_chars_long__
LOGIN_SESSION_COOKIE_SECRET=CHANGE_ME_at_least_32_characters_long
LOGIN_CLIENT_PAT_EXPIRATION=2099-01-01T00:00:00Z

# ---- PostgreSQL (separate roles/databases) ----
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
ZITADEL_DB_NAME=zitadel
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=CHANGE_ME
BDREN_DB_NAME=bdren
BDREN_DB_USER=bdren
BDREN_DB_PASSWORD=CHANGE_ME

# Bootstrap admin PAT expiry (short-lived!)
BOOTSTRAP_PAT_EXPIRATION=2027-01-01T00:00:00Z

# ---- Django (host-run dev: see scripts/test_backend.sh) ----
DJANGO_SECRET_KEY=CHANGE_ME_long_random
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
OIDC_ISSUER=http://auth.bdren.localhost:8080
OIDC_INTERNAL_BASE_URL=            # set only if the issuer URL isn't reachable from Django
OIDC_CLIENT_ID=                    # from scripts/bootstrap_zitadel.py output
OIDC_CLIENT_SECRET=                # from .zitadel-secrets.json (never commit)
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback/
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8000/api/v1/auth/logged-out/
OIDC_ALLOWED_REDIRECT_ORIGINS=http://localhost:8000
